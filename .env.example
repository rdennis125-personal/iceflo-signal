# ICEFLO Signal local environment template
#
# Copy this file to .env or set these values in your shell.
# Do not commit real folder IDs, credentials, tokens, PHI, or client secrets.

# Google Drive folder shared by the Mindful Oregon SimplePractice export account.
ICEFLO_MINDFUL_OREGON_DRIVE_FOLDER_ID=

# Local path to the OAuth client secret JSON downloaded from Google Cloud Console.
# Example:
# ICEFLO_GOOGLE_OAUTH_CLIENT_SECRETS_PATH=C:\secure\iceflo-signal\client_secret.json
ICEFLO_GOOGLE_OAUTH_CLIENT_SECRETS_PATH=

# Local path where ICEFLO Signal can store the generated OAuth user token.
# Example:
# ICEFLO_MINDFUL_OREGON_GOOGLE_TOKEN_PATH=C:\secure\iceflo-signal\mindful_oregon_token.json
ICEFLO_MINDFUL_OREGON_GOOGLE_TOKEN_PATH=
