<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ envelope.email_title | default('Weekly Report') }}</title>
</head>
<body style="margin:0; padding:0; background:#F7F2EA; font-family:Arial, Helvetica, sans-serif; color:#23413A;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#F7F2EA; padding:28px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:680px; background:#FFFFFF; border-radius:22px; overflow:hidden; box-shadow:0 8px 24px rgba(35,65,58,0.08);">
          <tr>
            <td style="background:#23413A; padding:26px 32px; color:#FFFFFF;">
              <div style="font-size:13px; letter-spacing:.08em; text-transform:uppercase; color:#D8C7AE;">{{ envelope.organization_name }}</div>
              <h1 style="margin:8px 0 0; font-size:28px; line-height:1.2; font-weight:700;">{{ envelope.report_title }}</h1>
              <div style="margin-top:8px; font-size:15px; color:#E9DED0;">{{ envelope.report_period }}</div>
            </td>
          </tr>
          <tr>
            <td style="padding:30px 32px 10px;">
              <p style="margin:0 0 18px; font-size:16px; line-height:1.6; color:#31564E;">{{ envelope.intro_text }}</p>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                <tr>
                  {% for metric in payload.metric_cards %}
                  <td width="33.33%" style="padding:6px; vertical-align:top;">
                    <div style="background:#F7F2EA; border:1px solid #E4D8C8; border-radius:16px; padding:16px;">
                      <div style="font-size:12px; color:#5E8C86; text-transform:uppercase; letter-spacing:.06em;">{{ metric.label }}</div>
                      <div style="font-size:28px; line-height:1.2; font-weight:700; color:#23413A; margin-top:6px;">{{ metric.value }}</div>
                      <div style="font-size:13px; line-height:1.4; color:#61746E; margin-top:4px;">{{ metric.note }}</div>
                    </div>
                  </td>
                  {% endfor %}
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:10px 32px 30px;">
              {{ envelope.content_html | safe }}
            </td>
          </tr>
          <tr>
            <td style="background:#F2E8DB; padding:22px 32px; font-size:12px; line-height:1.5; color:#61746E;">
              {{ envelope.footer_text }}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
